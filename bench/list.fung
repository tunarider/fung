# One pass of each iterating native over a list of 500,000 values
xs = map(0..500000, i => i * 7 % 1000)
ys = filter(map(xs, x => x + 1), x => x % 2 == 0)
total = atom(0)
each(ys, y => swap(total, t => t + y))
hit = find(xs, x => x == 999)
zs = sort_by(xs, x => -x)
print(deref(total) + hit + zs[0] + len(ys))
