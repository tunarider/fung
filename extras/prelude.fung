# The part of the prelude written in fung (06: 네 층, built-in extras):
# the combinators the core's fold/map/for/slices can build, the process
# functions of the native bridge, and two iteration helpers. The core
# keeps the functions that walk elements natively (map, filter, fold, …).
# The concurrency helpers (fan_in, pmap, retry) are the module `conc`.
import _native.arg as _arg
import _native.process as _p
import _native.range as _r

# Process functions (06), from the native bridge.
exec = _p.exec
sh = _p.sh
env = _p.env
env_all = _p.env_all

# ---- Collections ----------------------------------------------------

# A range is not counted: it may hold more numbers than len can (02).
fn is_empty(x) = type_of(x) == 'range then _r.last(x) == nil else len(x) == 0

# Positional access needs a list: ranges (and receiving ends, received
# until closed) become one. Anything else is E0506 with `verb`, the
# function the user called ("cannot zip the elements of int").
fn _list(xs, verb) = type_of(xs) == 'list then xs else map(_r.items(xs, verb), x => x)

# A range's first number. The range natives (_r) give the rest without
# counting it, so first/last/take/drop build only what they return, and a
# range wider than the int range works too (02).
fn _start(r) = find(r, x => true)

# Up to n values from a receiving end, stopping early: the rest stays in
# the channel (05).
fn _receive(rx, n, acc) = n <= 0 then acc else match recv(rx):
  Ok(x)  => _receive(rx, n - 1, acc + [x])
  Err(_) => acc
;;

# A range is cut to the other side's length before it becomes a list.
fn zip(xs, ys):
  left = type_of(xs) == 'range then xs else _list(xs, "zip the elements of")
  right = type_of(ys) == 'range then _upto(ys, len(left)) else _list(ys, "zip the elements of")
  cut = _upto(left, len(right))
  n = min([len(cut), len(right)])
  for i in 0..n: (cut[i], right[i]) ;;
;;

# A range's first n numbers as a list; anything else as it is.
fn _upto(xs, n) = type_of(xs) == 'range then map(_r.slice(xs, 0, n), x => x) else xs

fn first(xs):
  if type_of(xs) == 'range: return _start(xs) ;;
  ys = type_of(xs) == 'receiver then _receive(xs, 1, []) else _list(xs, "take the first of")
  is_empty(ys) then nil else ys[0]
;;

fn last(xs):
  if type_of(xs) == 'range: return _r.last(xs) ;;
  ys = _list(xs, "take the last of")
  is_empty(ys) then nil else ys[-1]
;;

# take/drop never fail on a count past the end (06): n is cut to len
# (by _r.slice for a range). A count that is not a non-negative int is
# E0403, as for a native (SP15). A string is no collection: it is cut
# with slices (02).
fn _clamp(n, size):
  _arg.count("n", n)
  n > size then size else n
;;

fn take(xs, n):
  if type_of(xs) == 'receiver: return _receive(xs, _clamp(n, n), []) ;;
  if type_of(xs) == 'range: return map(_r.slice(xs, 0, _clamp(n, n)), x => x) ;;
  ys = _list(xs, "take from")
  ys[.._clamp(n, len(ys))]
;;

fn drop(xs, n):
  if type_of(xs) == 'range: return map(_r.slice(xs, _clamp(n, n)), x => x) ;;
  ys = _list(xs, "drop from")
  ys[_clamp(n, len(ys))..]
;;

fn contains(c, x) = x in c

# ---- Strings --------------------------------------------------------

# The padding that brings s up to n characters, cycling pad. repeat
# builds just enough copies (never more than missing + len(pad) chars).
# An empty pad, or a width that is not a non-negative int, is E0403, as
# for a native (_r.pad, _arg.count).
fn _padding(s, n, pad):
  _arg.count("n", n)
  _r.pad(pad)
  missing = n - len(s)
  missing <= 0 then "" else repeat(pad, int(missing / len(pad)) + 1)[..missing]
;;

fn pad_left(s: str, n: int, pad: str = " ") = _padding(s, n, pad) + s
fn pad_right(s: str, n: int, pad: str = " ") = s + _padding(s, n, pad)

# ---- Results --------------------------------------------------------

fn is_ok(x) = type_of(x) == 'Ok
fn is_err(x) = type_of(x) == 'Err

# ---- Iteration ------------------------------------------------------

# Applies f until pred holds.
fn until(x, f: fn, pred: fn) = pred(x) then x else until(f(x), f, pred)

# Applies f n times; n is a non-negative int (E0403, SP15).
fn iterate(x, f: fn, n: int) = _iterate(x, f, _arg.count("n", n))
fn _iterate(x, f, n) = n == 0 then x else _iterate(f(x), f, n - 1)
