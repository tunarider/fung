# The part of the prelude written in fung (06: 네 층, built-in extras):
# the combinators the core's fold/map/for/slices can build, the process
# functions of the native bridge, and two iteration helpers. The core
# keeps the functions that walk elements natively (map, filter, fold, …).
# The concurrency helpers (fan_in, pmap, retry) are the module `conc`.
import _native.process as _p
import _native.range as _r

# Process functions (06), from the native bridge.
exec = _p.exec
sh = _p.sh
env = _p.env

# ---- Collections ----------------------------------------------------

# A range is not counted: it may hold more numbers than len can (02).
fn is_empty(x) = type_of(x) == 'range then _r.last(x) == nil else len(x) == 0

fn sum(xs) = fold(xs, 0, (acc, x) => acc + x)

# Positional access needs a list: ranges (and receiving ends, received
# until closed) become one.
fn _list(xs) = type_of(xs) == 'list then xs else map(xs, x => x)

# A range's first number. The range natives (_r) give the rest without
# counting it, so first/last/take/drop build only what they return, and a
# range wider than the int range works too (02).
fn _start(r) = find(r, x => true)

# Up to n values from a receiving end, stopping early: the rest stays in
# the channel (05).
fn _receive(rx, n, acc) = n <= 0 then acc else match recv(rx):
  Ok(x)  => _receive(rx, n - 1, acc + [x])
  Err(_) => acc
;;

# min/max: nil for an empty collection; the first element seeds the fold
# so a nil element fails as `<` does instead of being skipped.
fn min(xs):
  ys = _list(xs)
  is_empty(ys) then nil else fold(ys[1..], ys[0], (best, x) => x < best then x else best)
;;

fn max(xs):
  ys = _list(xs)
  is_empty(ys) then nil else fold(ys[1..], ys[0], (best, x) => x > best then x else best)
;;

fn reverse(xs):
  ys = _list(xs)
  n = len(ys)
  for i in 0..n: ys[n - 1 - i] ;;
;;

fn range(a, b = nil) = b == nil then 0..a else a..b

fn zip(xs, ys):
  left = _list(xs)
  right = _list(ys)
  n = min([len(left), len(right)])
  for i in 0..n: (left[i], right[i]) ;;
;;

fn first(xs):
  if type_of(xs) == 'range: return _start(xs) ;;
  ys = type_of(xs) == 'receiver then _receive(xs, 1, []) else _list(xs)
  is_empty(ys) then nil else ys[0]
;;

fn last(xs):
  if type_of(xs) == 'range: return _r.last(xs) ;;
  ys = _list(xs)
  is_empty(ys) then nil else ys[-1]
;;

# take/drop never fail on a count out of range (06): n is clamped into
# 0..=len (by _r.slice for a range). A count not an int is the caller's bug.
# A string is cut by characters, like its slices.
fn _clamp(verb, n, size):
  if type_of(n) != 'int: fail("${verb} expects an int count, got ${type_of(n)}") ;;
  n < 0 then 0 else (n > size then size else n)
;;

fn take(xs, n):
  if type_of(xs) == 'receiver: return _receive(xs, _clamp("take", n, n), []) ;;
  if type_of(xs) == 'range: return map(_r.slice(xs, 0, _clamp("take", n, n)), x => x) ;;
  if type_of(xs) == 'str: return xs[.._clamp("take", n, len(xs))] ;;
  ys = _list(xs)
  ys[.._clamp("take", n, len(ys))]
;;

fn drop(xs, n):
  if type_of(xs) == 'range: return map(_r.slice(xs, _clamp("drop", n, n)), x => x) ;;
  if type_of(xs) == 'str: return xs[_clamp("drop", n, len(xs))..] ;;
  ys = _list(xs)
  ys[_clamp("drop", n, len(ys))..]
;;

fn contains(c, x) = x in c

fn keys(m) = pairs(m) |> map(((k, _)) => k)
fn values(m) = pairs(m) |> map(((_, v)) => v)

# ---- Strings --------------------------------------------------------

# The padding that brings s up to n characters, cycling pad. repeat
# builds just enough copies (never more than missing + len(pad) chars).
fn _padding(s, n, pad) = match (pad, n - len(s)):
  ("", _)                        => fail("pad must be a non-empty string")
  (_, missing) when missing <= 0 => ""
  (_, missing)                   => repeat(pad, int(missing / len(pad)) + 1)[..missing]
;;

fn pad_left(s, n, pad = " ") = _padding(s, n, pad) + s
fn pad_right(s, n, pad = " ") = s + _padding(s, n, pad)

fn _chomp(s, suffix) = ends_with(s, suffix) then s[..len(s) - len(suffix)] else s

# Text to lines, the same rule as read_lines (06): split on `\n`, drop a
# trailing `\r` per line, and a final newline makes no empty line.
fn lines(s) = match s:
  "" => []
  _  => split(_chomp(s, "\n"), "\n") |> map(l => _chomp(l, "\r"))
;;

# ---- Results --------------------------------------------------------

fn is_ok(x) = type_of(x) == 'Ok
fn is_err(x) = type_of(x) == 'Err

# ---- Iteration ------------------------------------------------------

# Applies f until pred holds.
fn until(x, f, pred) = pred(x) then x else until(f(x), f, pred)

# Applies f n times.
fn iterate(x, f, n) = n <= 0 then x else iterate(f(x), f, n - 1)
