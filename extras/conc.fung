# conc (stage 6a): the concurrency helpers written in fung over the
# concurrency builtins (05).
#
# They are a module, not prelude names: the prelude keeps only what
# every script needs. A program imports the module: `import conc`, then
# `conc.pmap(...)`. Calling one of them without the module is E0204,
# with a help line that names the module.

# Merges receiving ends into one (05): a forwarding task per input, in
# scope `s`, sends to the output's sending end; the returned receiving
# end closes when every input has closed. Once the returned end is gone
# (a send gives Err), every forwarder stops and the inputs are let go,
# so their producers' sends give Err in turn.
fn fan_in(s, rxs):
  (tx, rx) = channel(len(rxs))
  spawn(s, fn():
    _ = scope(fn(inner):
      each(rxs, r => spawn(inner, fn(): _forward(r, tx) then cancel(inner) else nil ;;))
    ;;)
    close(tx)
  ;;)
  rx
;;

# Sends what r gives to tx until r closes (false) or nobody can receive
# from tx any more (true).
fn _forward(r, tx) = match recv(r):
  Ok(v) => is_ok(send(tx, v)) then _forward(r, tx) else true
  _     => false
;;

# Parallel map: at most `limit` tasks at once (0 = no limit), results in
# input order, in a scope of its own: a runtime error in f fails pmap
# (05), an Err that f returns is a result like any other.
fn pmap(xs, f, limit = 0):
  items = xs |> map(x => x)
  limit <= 0 or limit >= len(items)
    then _pmap_all(items, f)
    else _pmap_workers(items, f, limit)
;;

fn _pmap_all(items, f) = scope(s => items |> map(x => spawn(s, () => f(x))) |> map(await))

# `limit` workers take the next index from a channel as each finishes, so
# a slow item holds up only its own worker. Each gives its (index, value)
# pairs; sorting by index puts the results back in input order.
fn _pmap_workers(items, f, limit):
  (jobs_tx, jobs) = channel(len(items))
  each(0..len(items), i => send(jobs_tx, i))
  close(jobs_tx)
  done = scope(s => 0..limit |> map(_ => spawn(s, () => _work(items, f, jobs, []))) |> map(await))
  done |> flatten |> sort_by(((i, _)) => i) |> map(((_, v)) => v)
;;

fn _work(items, f, jobs, acc) = match recv(jobs):
  Ok(i) => _work(items, f, jobs, acc + [(i, f(items[i]))])
  _     => acc
;;

# Calls f until it returns a non-Err value, at most `times` tries,
# sleeping `delay` between tries; the last Err is returned (06).
fn retry(f, times = 3, delay = 0ms):
  r = f()
  times <= 1 or not is_err(r) then r else _retry_after(f, times - 1, delay)
;;

fn _retry_after(f, times, delay):
  sleep(delay)
  retry(f, times: times, delay: delay)
;;
