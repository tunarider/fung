# conc (stage 6a): the concurrency helpers written in fung over the
# concurrency builtins (05).
#
# They are a module, not prelude names: the prelude keeps only what
# every script needs. A program imports the module: `import conc`, then
# `conc.pmap(...)`. Calling one of them without the module is E0204,
# with a help line that names the module.
import _native.conc as _c

# Merges channels into one (05): a forwarding task per input; the output
# closes when every input has closed.
fn fan_in(chs):
  out = channel(len(chs))
  tasks = for ch in chs: _c.spawn_awaited(() => each(ch, v => send(out, v))) ;;
  spawn(fn():
    each(tasks, await)
    close(out)
  ;;)
  out
;;

# Parallel map: at most `limit` tasks at once (0 = no limit), results in
# input order. A failing f shows up as its Err, like await would.
fn pmap(xs, f, limit = 0):
  items = xs |> map(x => x)
  limit <= 0 or limit >= len(items)
    then items |> map(x => _c.spawn_awaited(() => f(x))) |> map(await)
    else _pmap_chunks(items, f, limit, [])
;;

fn _pmap_chunks(items, f, limit, acc) = is_empty(items) then acc
  else _pmap_chunks(drop(items, limit), f, limit,
    acc + (take(items, limit) |> map(x => _c.spawn_awaited(() => f(x))) |> map(await)))

# Calls f until it returns a non-Err value, at most `times` tries,
# sleeping `delay` between tries; the last Err is returned (06).
fn retry(f, times = 3, delay = 0ms):
  r = f()
  times <= 1 or not is_err(r) then r else _retry_after(f, times - 1, delay)
;;

fn _retry_after(f, times, delay):
  sleep(delay)
  retry(f, times: times, delay: delay)
;;
