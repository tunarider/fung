# Agents (stage 3b, the Rust implementation only; the Go implementation
# keeps its atoms and never reads this file). An agent is a background
# task that holds a state and serves requests from a channel, one at a
# time: `swap(a, f)` replaces the state with f(state), `deref(a)` reads
# it. The Rust boot adds the public names to the prelude.
#
# The agent's loop holds only its request channel, never a handle: the
# handle closes the channel when its last copy drops, which ends the
# loop, so a loop holding a handle would never end.
import _native.conc as _c

fn agent(v):
  ch = channel()
  _c.spawn_background(() => _serve(ch, v))
  _c.agent_handle(ch)
;;

# Requests are ('swap, f, reply) and ('deref, reply); reply is a fresh
# channel with room for the answer. A closed channel (no handle is left)
# ends the loop.
fn _serve(ch, state) = match recv(ch):
  Ok(('swap, f, reply)) => _serve(ch, _apply(ch, state, f, reply))
  Ok(('deref, reply))   => _serve(ch, _answer(reply, state))
  Err(_)                => nil
;;

# Runs f on the state, marked as serving (for E0704 and for deref inside
# f), and answers Ok(new) or the caught Err(error). Returns the state to
# keep: a failing f changes nothing.
fn _apply(ch, state, f, reply):
  _c.agent_busy(ch, true, state)
  r = _c.try_call(f, state)
  _c.agent_busy(ch, false)
  _c.send_unchecked(reply, r)
  match r:
    Ok(n)  => n
    Err(_) => state
  ;;
;;

fn _answer(reply, state):
  _c.send_unchecked(reply, state)
  state
;;

# Waits for the answer to a request (the reply channel is never closed).
fn _ask(ch, request, reply):
  _c.send_unchecked(ch, request)
  recv(reply)!
;;

# swap_channel checks the arguments (E0403) and that this is not the
# agent's own f (E0704). An error in f is raised again here, so it
# points at the caller's swap.
fn swap(a, f):
  reply = channel(1)
  match _ask(_c.swap_channel(a, f), ('swap, f, reply), reply):
    Ok(n)  => n
    Err(e) => _c.raise(e)
  ;;
;;

# Inside the agent's own f, the state before the update, without
# waiting (the agent is busy running f).
fn deref(a) = _c.in_agent(a) then _c.agent_state(a) else _deref(_c.agent_channel(a))

fn _deref(ch):
  reply = channel(1)
  _ask(ch, ('deref, reply), reply)
;;
