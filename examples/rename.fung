#!/usr/bin/env fung
# Renames every file in a directory to kebab-case:
#   "My Report (final).TXT" -> "my-report-final.txt"
# usage: fung examples/rename.fung <dir> [--dry-run]
import fs
import path
import cli
import "./kebab" (target)

fn rename_all(folder, dry):
  for file in fs.list(folder)!:
    to = target(file)
    if to != file:
      print(file, "->", to)
      if not dry: fs.move(path.join(folder, file), path.join(folder, to))! ;;
    ;;
  ;;
  nil
;;

opts = cli.parse(args, bools: ["dry-run"])!
dir = first(opts.rest) ?? fail("usage: rename.fung <dir> [--dry-run]")
rename_all(dir, get(opts.flags, "dry_run", false))
