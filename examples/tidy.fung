#!/usr/bin/env fung
# Lists the largest files under a directory; with --trash <dir> moves them there.
# usage: fung examples/tidy.fung <dir> [n] [--trash <trash-dir>]
import fs
import path
import cli
import "./bigfiles" (largest, human)

opts = cli.parse(args)
dir = first(opts.rest) ?? fail("usage: tidy.fung <dir> [n] [--trash <trash-dir>]")
n = len(opts.rest) > 1 then int(opts.rest[1]) else 5
trash = get(opts.flags, "trash")

for (p, size) in largest(dir, n):
  print(pad_left(human(size), 8), p)
  if trash != nil:
    fs.mkdir(trash)!
    fs.move(p, path.join(trash, path.base(p)))!
  ;;
;;
