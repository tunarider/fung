# A catch-all arm last, or one with a guard, is fine.
limit = 5
fn f(x) = match x:
  v when v == limit => "at limit"
  n when n > 10     => "big"
  _                 => "other"
;;
print(f(5), f(11), f(3))
# expect: at limit big other
fn pick(m) = match m:
  1 => (y => y + 1)
  _ => (y => y)
;;
print(pick(1)(1), pick(2)(1))
# expect: 2 1
