# An unnamed rest `...` binds no name (D93), so two of them in one
# pattern, or in two parameters, are fine.
fn firsts([a, ...], [b, ...]) = a + b
print(firsts([1, 2], [3, 4]))
([c, ...], [d, ...]) = ([1, 2], [3, 4])
print(c, d)
match [5, 6]:
  [a, ...] | [a] => print(a)
;;
# expect: 4
# expect: 1 3
# expect: 5
