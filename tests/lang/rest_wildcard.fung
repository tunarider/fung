# `..._` is `...`: it binds no name (FE11), so two of them in one
# pattern, or in two parameters, are fine.
fn firsts([a, ..._], [b, ..._]) = a + b
print(firsts([1, 2], [3, 4]))
([c, ..._], [d, ..._]) = ([1, 2], [3, 4])
print(c, d)
match [5, 6]:
  [a, ..._] | [a] => print(a)
;;
# expect: 4
# expect: 1 3
# expect: 5
