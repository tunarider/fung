# Only Ok(x) and Err(e) exist (SP12): a pipe fills the one value, and a
# tuple carries several.
print(Ok(1) ?? 0, Err("x") ?? 0)
# expect: 1 0
print(1 |> Ok, (1, 2) |> Ok())
# expect: Ok(1) Ok((1, 2))
print(match Ok((1, 2)): Ok((a, b)) => a + b ;;)
# expect: 3
fn load(r: Ok | Err) -> Ok | Err = r
print(load(Err('x)))
# expect: Err('x)
