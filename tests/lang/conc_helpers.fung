a = channel(2)
b = channel(2)
each([1, 2], x => send(a, x))
close(a)
send(b, 3)
close(b)
print(fan_in([a, b]) |> map(x => x) |> sort, pmap([1, 2, 3], x => x * x, limit: 2), pmap([], x => x))
# expect: [1, 2, 3] [1, 4, 9] []
n = atom(0)
print(retry(fn(): swap(n, x => x + 1) < 3 then Err('again) else Ok("done") ;;, times: 5), deref(n), retry(() => Err("never"), times: 2))
# expect: Ok("done") 3 Err("never")
