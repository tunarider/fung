# Scopes: the body's value (in Ok, D65), waiting for the children, await
# inside.
print(scope(_s => 1 + 1))
r = scope(fn(s):
  a = spawn(s, () => 2)
  b = spawn(s, () => Err('e))
  [await(a), await(b)]
;;)!
print(r)
(tx, rx) = channel(1)
scope(s => spawn(s, () => send(tx, 'done)))
print(recv(rx))
scope(fn(s): print(s, type_of(s), s == s) ;;)
# expect: Ok(2)
# expect: [Ok(2), Ok(Err('e))]
# expect: Ok('done)
# expect: <scope> 'scope true
