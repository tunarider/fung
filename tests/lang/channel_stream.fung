# Iterating a channel calls the function as each value arrives.
ch = channel()
ack = channel()
fn produce(ch, ack):
  for x in 1..=3:
    send(ch, x)
    recv(ack)
  ;;
  close(ch)
;;
spawn(fn(): produce(ch, ack) ;;)
for x in ch:
  print("got ${x}")
  send(ack, nil)
;;
print("done")
# expect: got 1
# expect: got 2
# expect: got 3
# expect: done

# Functions that stop early leave the rest in the channel.
b = channel(3)
send(b, 1); send(b, 2); send(b, 3); close(b)
print(find(b, x => x == 2), recv(b))
# expect: 2 Ok(3)
c = channel(4)
send(c, 1); send(c, 2); send(c, 3); send(c, 4); close(c)
print(take(c, 2), first(c), recv(c), first(c))
# expect: [1, 2] 3 Ok(4) nil

# Argument errors come before any value is received.
d = channel(2)
send(d, 1); send(d, 2); close(d)
t = spawn(fn(): map(d, 3) ;;)
print(type_of(await(t)), recv(d))
# expect: 'Err Ok(1)
