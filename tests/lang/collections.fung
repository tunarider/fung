print([3, 1, 2] |> sort, [1, 2, 3] |> filter(x => x > 1) |> map(x => x * 10), fold(1..=4, 0, (a, x) => a + x))
# expect: [1, 2, 3] [20, 30] 10
print(take([1, 2, 3], 2), drop([1, 2, 3], 2), first([]), zip([1], ["a"]), unique([1, 1]), flatten([[1], [2]]))
# expect: [1, 2] [3] nil [(1, "a")] [1] [1, 2]
print(["héllo"[..2], "héllo"[3..], chars("ab") |> take(5) |> join, sym_name('ok), is_utf8("é")])
# expect: ["hé", "lo", "ab", "ok", true]
print(group_by(["aa", "b", "cc"], s => str(len(s))), pairs({a: 1}), get({}, "x", 0), put({}, "k", 1))
# expect: {"2": ["aa", "cc"], "1": ["b"]} [("a", 1)] 0 {k: 1}
each([1, 2], x => print(x))
# expect: 1
# expect: 2
print(reverse([1, 2, 3]), reverse(0..3), reverse(3..3), reverse([]), keys({b: 1, a: 2}), values({b: 1, a: 2}), keys({}))
# expect: [3, 2, 1] [2, 1, 0] [] [] ["b", "a"] [1, 2] []
print(sum([]), sum([2.5]), sum(["a", "b"]), sum([[1], [2]]), sum([1s, 2s]), sum(1..=100), sum(-3..3))
# expect: 0 2.5 ab [1, 2] 3s 5050 -3
print(min([]), min([2, 1.0, 1]), max([1, 2.0, 2]), min(3..7), max(3..7), max(7..7), min(["b", "a"]))
# expect: nil 1.0 2.0 3 6 nil a
