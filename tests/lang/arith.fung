print(1 + 2 * 3)
# expect: 7
print((1 + 2) * 3, 1 - 2 - 3)
# expect: 9 -4
print(7 // 2, 7 % 2, -7 // 2, -7 % 2, 7.5 // 2, -7.5 % 2)
# expect: 3 1 -4 1 3.0 0.5
print(10 / 4, 10 / 2, 1 + 2.5)
# expect: 2.5 5.0 3.5
print(2 ** 10, 2 ** -1, 2.0 ** 2, -2 ** 2, 2 ** 3 ** 2)
# expect: 1024 0.5 4.0 -4 512
print(0.1 + 0.2)
# expect: 0.30000000000000004
