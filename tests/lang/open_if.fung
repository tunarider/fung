# Where an if without else is fine: nobody uses its value (01).
if false: print("no") ;;
for x in [1, 2]:
  if x > 1: print(x) ;;
;;
# expect: 2

# A function's last item is its value, so a function that returns nothing
# says so after its if (L2).
fn shout(s):
  if s != "":
    print(s + "!")
  ;;
  nil
;;
shout("hi")
# expect: hi!
fn whisper(s):
  if s != "": print(s) else: nil ;;
;;
whisper("hm")
# expect: hm

# A value place says what it means with else.
x = if false: 1 else: nil ;;
print(x)
# expect: nil
y = if false:
  1
else if true:
  2
else:
  3
;;
print(y)
# expect: 2
z = match 1:
  1 => if false: 0 else: 1 ;;
  _ => 2
;;
print(z)
# expect: 1
