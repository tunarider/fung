# recv_now and send_now look once, without waiting (05).
(tx, rx) = channel(1)
print(recv_now(rx))
# expect: Err({kind: 'empty, message: "channel empty"})
print(send_now(tx, "job"), send_now(tx, "more"))
# expect: Ok(nil) Err({kind: 'full, message: "channel full"})
match recv_now(rx):
  Ok(v)                => print("got", v)
  Err({kind: 'empty})  => print("nothing yet")
  Err({kind: 'closed}) => print("done")
;;
# expect: got job
close(tx)
print(recv_now(rx))
# expect: Err({kind: 'closed, message: "channel closed"})
