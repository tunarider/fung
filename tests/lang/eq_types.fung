# == across types (D40): numbers compare across int and float, nil
# compares with anything, the rest of the same type only.
print(1 == 1.0, nil == 1, 1 != nil, [1, nil] == [1, 2], Ok(1) == Ok(1))
# expect: true false true false true
print(nil in [1, 2], 1.0 in 0..3, nil in 0..3, 2 in [1, 2])
# expect: false true false true
# == stops at the first difference, so a pair after it is not compared.
print([1, 'a] == [2, "a"], {x: 'a} == {y: "a"})
# expect: false false
# A literal pattern tests the type: a value of another type does not match.
fn kind(x) = match x:
  1   => "one"
  "1" => "text one"
  _   => "other"
;;
print(kind(1), kind("1"), kind(1.0), kind('a))
# expect: one text one one other
