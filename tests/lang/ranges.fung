print(0..3, 0..=3, len(0..10), 5 in 0..10, 10 in 0..10, 10 in 0..=10)
# expect: 0..3 0..=3 10 true false true
print(for i in 1..=3: i * i ;;, map(0..2, x => x))
# expect: [1, 4, 9] [0, 1]
print(2.0 in 0..5, 2.5 in 0..5, 2.0 in [0, 1, 2], contains(0..5, 2.0))
# expect: true false true true
w = -9223372036854775808..=9223372036854775807
print(is_empty(w), last(w), take(w, 2), drop(0..=9223372036854775807, 9223372036854775807))
# expect: false 9223372036854775807 [-9223372036854775808, -9223372036854775807] [9223372036854775807]
