# What a discarded Err (02) leaves alone.

# `_ = …` discards on purpose.
_ = Err("ignored")
_ = exec(["false"])

# A value place keeps the Err: an assignment, an argument, a fn's result.
r = Err("kept")
print(r)
# expect: Err("kept")
fn fails() = Err("returned")
print(fails())
# expect: Err("returned")
print(is_err(exec(["false"])))
# expect: true

# A for in a value place still builds its list, Errs and all.
xs = for x in [1, 2]: x == 2 then Err(x) else Ok(x) ;;
print(xs)
# expect: [Ok(1), Err(2)]

# A nested for statement in a for statement is discarded as well.
for x in [1, 2]:
  for y in [x]:
    print(y)
  ;;
;;
# expect: 1
# expect: 2

# Ok and other values are discarded as before, lists without an Err too.
# (A literal alone as a statement does nothing, E0234: compute it.)
fn value(v) = v
value(Ok(1))
nil
value([Ok(1), 2])
fn oks() = map([1, 2], x => Ok(x))
oks()
each([1], x => [Ok(x)])
fn names(items): for x in items: "n${x}" ;; ;;
print(names([1, 2]))
# expect: ["n1", "n2"]

# A value without an Err anywhere in it is discarded as before (D54:
# an Err at any depth is E0606, see err_discard_deep_*).
value([[Ok(1)]])
value([(Ok(1), 2)])
value([{e: Ok(1)}])
print("done")
# expect: done
