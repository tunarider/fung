xs = [1, 2, 3]
i = nil
print(xs[1..=2], xs[0..=2], xs[i ?? 0], xs[true then 1 else 2])
# expect: [2, 3] [1, 2, 3] 1 2
# `xs[a..=b]` is exactly `xs[a..b + 1]` (D117): an empty slice from any
# start, the range value of the same ends too.
fn front(ys, n) = ys[0..=n - 1]
r = 0..=-1
print([front(xs, 0), front("abc", 0), front(xs, 2), xs[3..=2], xs[r], "abc"[r]])
# expect: [[], "", [1, 2], [], [], ""]
