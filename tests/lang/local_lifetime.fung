# A local's last read hands its value over, and a local is let go after
# the statement that reads it last (03), so a channel a function made
# closes when its producer is done.
fn tens() = scope(fn(s):
  (tx, rx) = channel()
  spawn(s, () => each(0..3, i => send(tx, i)))
  for x in rx: x * 10 ;;
;;)!
print(tens())
# expect: [0, 10, 20]

# Read last inside a branch: let go after the statement holding it.
fn pick(flag) = scope(fn(s):
  (tx, rx) = channel(3)
  if flag:
    spawn(s, () => send(tx, 1))
  else:
    spawn(s, () => send(tx, 2))
  ;;
  for x in rx: x ;;
;;)!
print(pick(true), pick(false))
# expect: [1] [2]

# The last read hands the value over within its statement: the sending
# end moves into `drop_it`, which lets it go, so the channel is closed
# before `recv` waits.
fn drop_it(_x) = nil
fn closes_early() = scope(fn(_s):
  (tx, rx) = channel()
  [drop_it(tx), recv(rx)]
;;)!
print(closes_early())
# expect: [nil, Err({kind: 'closed, message: "channel closed"})]

# Inside a branch, a statement lets go of what it read last: the closure
# that held the sending end is gone, so the loop ends (03).
fn in_branch(flag):
  if flag:
    (tx, rx) = channel(1)
    f = () => send(tx, 1)
    f()!
    for x in rx: x ;;
  else:
    []
  ;;
;;
print(in_branch(true))
# expect: [1]

# A match arm is a block too.
fn in_arm(v) = match v:
  'go =>
    (tx, rx) = channel(1)
    f = () => send(tx, 2)
    f()!
    for x in rx: x ;;
  _   => []
;;
print(in_arm('go))
# expect: [2]

# On a path that never reads it again, a local goes at the first statement
# that ends there, though another branch still reads it.
fn other_path(flag):
  (tx, rx) = channel(2)
  send(tx, 9)!
  if flag:
    send(tx, 1)!
    []
  else:
    head = recv(rx)!
    for x in rx: x + head ;;
  ;;
;;
print(other_path(false))
# expect: []

# Sibling blocks reuse their slots: the second block's names do not keep
# the first block's sending end alive.
fn siblings():
  if true:
    (tx, rx) = channel(1)
    drop_it(tx)
    print("first:", recv(rx))
  ;;
  if true:
    (tx, rx) = channel(1)
    send(tx, 4)!
    for x in rx: x ;;
  else:
    []
  ;;
;;
print(siblings())
# expect: first: Err({kind: 'closed, message: "channel closed"})
# expect: [4]

# A local never read lives on until the function returns, in a branch too.
fn kept(flag):
  if flag:
    (_tx, rx) = channel(1)
    recv_now(rx)
  else:
    nil
  ;;
;;
print(kept(true))
# expect: Err({kind: 'empty, message: "channel empty"})

# The entry file's blocks follow the same rule: the last read hands the
# value over, and the statement after it lets go.
if true:
  (tx, rx) = channel(1)
  drop_it(tx)
  print("top move:", recv(rx))
;;
# expect: top move: Err({kind: 'closed, message: "channel closed"})
if true:
  (tx, rx) = channel(1)
  f = () => send(tx, 3)
  f()!
  print("top clear:", for x in rx: x ;;)
;;
# expect: top clear: [3]

# A failed arm binds nothing: a name its pattern wrote before the guard
# or the rest of the pattern failed is let go like any other (VM14).
fn guard_fails():
  (tx, rx) = channel(1)
  p = (tx, 2)
  print(match p:
    (t, n) when n == 1 => send(t, n)
    _                  => "other"
  ;;)
  for x in rx: print(x) ;;
  print("done")
;;
guard_fails()
# expect: other
# expect: done
fn pair_and_rx():
  (tx, rx) = channel(1)
  ((tx, 2), rx)
;;
fn pattern_fails():
  (p, rx) = pair_and_rx()
  print(match p:
    (_t, 1) => "one"
    _       => "other"
  ;;)
  for x in rx: print(x) ;;
  print("done")
;;
pattern_fails()
# expect: other
# expect: done
fn alternative_fails(k):
  (p, rx) = pair_and_rx()
  print(match p:
    (_t, 1) | (_t, 3) when k > 0 => "one or three"
    _                            => "other"
  ;;)
  for x in rx: print(x) ;;
  print("done")
;;
alternative_fails(1)
# expect: other
# expect: done

# A branch lets go, as it starts, of what only the other branches read
# (VM19, D61): the `else` here needs no statement for `tx` to go.
fn go(flag):
  (tx, rx) = channel(1)
  if flag:
    send(tx, 1)
  else:
    for x in rx: x ;;
  ;;
;;
print(go(false))
# expect: []

# A capture that is the last read lets go right after the function value
# is made, inside the statement (VM19).
fn captured_last() = scope(fn(s):
  (tx, rx) = channel(1)
  [spawn(s, () => send(tx, 1)) == nil, for x in rx: x ;;]
;;)!
print(captured_last())
# expect: [false, [1]]

# An arm's body lets go of what only its guard read (VM19).
fn ready(tx) = send(tx, 1) == Ok(nil)
fn guarded():
  (tx, rx) = channel(1)
  match 1:
    n when ready(tx) => for x in rx: x + n ;;
    _                => []
  ;;
;;
print(guarded())
# expect: [2]

# The paths of `??`, `and` and `or` let go, as they start, of what only
# the other path reads, in a value and in a condition (VM19).
fn coalesced(m):
  (tx, rx) = channel(1)
  [m ?? send(tx, 1), for x in rx: x ;;]
;;
print(coalesced(5), coalesced(nil))
# expect: [5, []] [Ok(nil), [1]]
fn either(flag):
  (tx, rx) = channel(1)
  [flag or send(tx, 1) == Ok(nil), for x in rx: x ;;]
;;
print(either(true), either(false))
# expect: [true, []] [true, [1]]
fn either_if(flag):
  (tx, rx) = channel(1)
  if flag or send(tx, 1) == Ok(nil): for x in rx: x ;; else: [] ;;
;;
print(either_if(true), either_if(false))
# expect: [] [1]
fn both_if(flag):
  (tx, rx) = channel(1)
  if flag and send(tx, 1) == Ok(nil): for x in rx: x ;; else: for x in rx: -x ;; ;;
;;
print(both_if(true), both_if(false))
# expect: [1] []
