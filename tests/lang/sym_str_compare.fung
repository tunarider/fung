# A symbol is not a string: the two are never equal (D91, see eq_types).
# Patterns test the type as well.
print(nil == 0, 'a == 'a, "a" == "a", 1 == 1.0)
# expect: false true true true
print('a in ['a, 'b], "x" in ["x"], 2 in [1, 2])
# expect: true true true
kind = "not_found"
r = match kind:
  'not_found  => "symbol"
  "not_found" => "string"
;;
print(r)
# expect: string
print(sym(kind) == 'not_found)
# expect: true
