# E0224 (formerly the warning W0104): a block used as a value whose last
# statement is an assignment. E0223: an if without else used as a value.
fn a():
  x = if true: _y = 1 else: 0 ;;
  x
;;

fn b():
  x = if true: 1 else if false: _z = 2 else: 3 ;;
  x
;;

fn c(v):
  return match v:
    1 => _w = 1
    _ => 2
  ;;
;;

print(if true: _q = 1 else: 0 ;;)
print(if true: 1 ;;)

fn d():
  x = if true:
    _inner = if false: _deep = 1 else: 0 ;;
  else:
    0
  ;;
  x
;;

fn e() = if true: 1 ;;

fn fine():
  if true: _not_used = 2 ;;
;;

fn also_fine():
  x = if true:
    y = 1
    y
  else:
    0
  ;;
  x
;;
