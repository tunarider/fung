counter = agent(0)
at_exit(() => print(deref(counter)))

test "swap":
  swap(counter, n => n + 1)
  assert deref(counter) == 1
;;
test "an agent that holds its own handle":
  a = agent(0)
  swap(a, _ => a)
  assert true
;;
test "a background loop":
  b = agent(0)
  swap(b, fn(_):
    spawn(fn():
      sleep(1h)
    ;;)
    1
  ;;)
  assert deref(b) == 1
;;
